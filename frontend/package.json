{
	"name": "wiki-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "yarn@1.22.22",
	"scripts": {
		"dev": "vite",
		"build": "vite build --base=/assets/wiki/frontend/ && yarn build:highlight && yarn copy-html-entry",
		"build:highlight": "vite build --config vite.highlight.config.js",
		"preview": "vite preview",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "node --test",
		"copy-html-entry": "cp ../wiki/public/frontend/index.html ../wiki/www/wiki-app.html"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.6.0",
		"@pierre/diffs": "^1.2.11",
		"@tiptap/core": "3.30.5",
		"@tiptap/extension-image": "3.30.4",
		"@tiptap/extension-list": "3.30.4",
		"@tiptap/extension-table": "3.30.4",
		"@tiptap/extensions": "3.30.4",
		"@tiptap/markdown": "3.30.4",
		"@tiptap/pm": "3.30.4",
		"@tiptap/starter-kit": "3.30.4",
		"@tiptap/suggestion": "3.30.4",
		"@tiptap/vue-3": "3.30.4",
		"@vueuse/core": "^14.1.0",
		"@vueuse/integrations": "^14.3.0",
		"@vueuse/router": "^14.2.1",
		"frappe-ui": "1.0.0-beta.25",
		"fuzzysort": "^3.1.0",
		"highlight.js": "~11.11.0",
		"idb-keyval": "^6.2.0",
		"pdfjs-dist": "4.10.38",
		"pinia": "^3.0.4",
		"prosemirror-model": "^1.25.9",
		"prosemirror-view": "^1.41.8",
		"reka-ui": "^2.10.1",
		"socket.io-client": "^4.7.2",
		"sortablejs": "^1.15.7",
		"tippy.js": "^6.3.7",
		"vue": "^3.5.13",
		"vue-pdf-embed": "2.1.4",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@vitejs/plugin-vue": "^5.1.4",
		"autoprefixer": "^10.4.2",
		"postcss": "^8.4.5",
		"tailwindcss": "^3.4.15",
		"vite": "^6.4.3"
	},
	"resolutions": {
